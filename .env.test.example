# Local Supabase instance for E2E testing
# These are well-known default keys for local Supabase development — not secrets.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-role-key>
# Get keys from `supabase status -o env` after `supabase start`

# App env vars (pointing to local Supabase)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-local-publishable-key>