{
  "name": "next-scaffold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:reset": "supabase db reset && playwright test",
    "test:ui": "playwright test --ui",
    "test:ci": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:show-report": "npx monocart show-report ./coverage/tests/monocart-report.html",
    "coverage:show-report": "npx monocart show-report ./coverage/tests/v8/index.html",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:push": "supabase db push",
    "supabase:reset": "supabase db reset",
    "supabase:gen-types": "supabase gen types --local --schema public > src/infrastructure/database/postgres/database.types.ts",
    "prepare": "husky"
  },
  "nano-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css}": "biome check --staged --no-errors-on-unmatched"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@sentry/nextjs": "^10.75.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "monocart-reporter": "^2.13.1",
    "nano-staged": "^1.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
